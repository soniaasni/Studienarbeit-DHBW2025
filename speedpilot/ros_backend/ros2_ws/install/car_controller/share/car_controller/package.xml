<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>car_controller</name>
  <version>0.0.0</version>
  <description>PWM-basierte Motor- und Lenkservosteuerung über GPIO (RPi.GPIO). Abonniert vehicle_command-Topic und gibt PWM-Signale an H-Brücke und Servo aus.</description>
  <maintainer email="sinacisonia@gmail.com">speedpilot</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>custom_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
